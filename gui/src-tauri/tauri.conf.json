{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMF GUI",
  "version": "0.1.0",
  "identifier": "dev.agentmainframe.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMF",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "linux": {
      "deb": {
        "depends": ["tmux"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
